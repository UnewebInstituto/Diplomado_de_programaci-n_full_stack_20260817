Algoritmo Ejemplo09_Ciclo_Para
	// La estructura Para, contiene la inicialización
	// de la variable contador, así como el incremento
	// Declaración de variables
	Definir i Como Entero
	Definir n Como Entero
	// Inicialización de variables
	n <- 5
	// +-- Inicialización de variable contador
	// !                    +-- Incremento variable contador
	// !                    !
	// v                    v
	Para i<-0 Hasta n-1 Con Paso 1 Hacer
		Escribir i
	FinPara
FinAlgoritmo
