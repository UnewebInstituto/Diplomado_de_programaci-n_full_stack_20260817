Algoritmo Ejemplo05_Ciclo_Mientras
	// Esta estructura de control repetitiva, tiene la característica
	// de que la condición de fin de ciclo, es verificada de entrar
	// al conjunto de acciones a realizar
	// Declaración de variables
	Definir i Como Entero
	Definir n Como Entero // representa el contador
	// Inicialización de variables
	i <- 0 // representa el número de veces a realizar el ciclo
	n <- 5
	// Ejecución del ciclo y escritura de resultados
	Mientras i<n Hacer
		Escribir i
		i <- i+1 // Acción a realizar
	FinMientras // Incremento de la variable de contador
FinAlgoritmo
