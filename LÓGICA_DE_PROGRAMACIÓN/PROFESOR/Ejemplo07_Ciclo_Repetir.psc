Algoritmo Ejemplo07_Ciclo_Repetir
	// El ciclo repertir tiene la particularidad, que la
	// verificación de la parada o final de ciclo, se hace
	// después de haber efectuado el ciclo, al menos
	// una vez.
	// Declaración de variables
	Definir i Como Entero
	Definir n Como Entero
	// Inicialización de variables
	i <- 0
	n <- 5
	Repetir
		Escribir i
		i <- i+1
	Hasta Que i==5
FinAlgoritmo
