Algoritmo Ejemplo7_ciclo_repetir
	// Declaracion de variables
	Definir i Como Entero
	Definir n Como Entero
	// Inicializacion de variables
	i <- 0
	n <- 5
	Repetir
		Escribir i // El ciclo repetir tiene la particularidad
		i <- i+1 // que la verificación de la parada o final de ciclo
	Hasta Que i==5 // después de haber efectuado el ciclo al menos una vez
FinAlgoritmo
