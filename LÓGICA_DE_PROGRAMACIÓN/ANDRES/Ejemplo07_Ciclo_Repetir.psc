Algoritmo Ejemplo07_Ciclo_Repetir
	// El ciclo repetir tiene la particularidad, que la
	// verificacion de la parada o final del ciclo, se Hacer
	// despues de haber efectuado el ciclo, al menos
	// una vez.
	// Declaracion de valiables
	Definir i Como Entero
	Definir n Como Entero
	// Inicializacion de variables
	i <- 0
	n <- 5
	Repetir
		Escribir i
		i <- i+1
	Hasta Que i==5
FinAlgoritmo
