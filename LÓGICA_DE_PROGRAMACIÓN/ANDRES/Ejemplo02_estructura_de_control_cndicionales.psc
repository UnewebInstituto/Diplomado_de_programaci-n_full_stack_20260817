Algoritmo Ejemplo02_estructura_de_control_cndicionales
	// Declaracion de variables
	Definir edad Como Entero
	// Inicializacion de variable
	edad <- 0
	// Lectura del valor
	Escribir 'Ejemplo02 Estructura de Control Condicional'
	Escribir 'Ingrese el siguiente dato:'
	Escribir 'Edad..:'
	Leer edad
	// Condicional dimple
	Escribir 'Resultado del condicional simple'
	Si edad>=18 Entonces
		Escribir '>>>Es mayor de edad.'
	FinSi
	Escribir 'Resultado del condicional comuesto'
	Si edad>=18 Entonces
		Escribir '>>>Esmayor de edad'
	SiNo
		Escribir '>>>Es menor de edad'
	FinSi
	Escribir '***Fin del programa***'
FinAlgoritmo
