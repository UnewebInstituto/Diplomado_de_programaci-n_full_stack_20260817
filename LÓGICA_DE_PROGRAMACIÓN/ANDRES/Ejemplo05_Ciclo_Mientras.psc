Algoritmo Ejemplo05_Ciclo_Mientras
	// Estea estructura de control repetiriiva, tine la caracteristica
	// de que la condicion de fin de ciclo, es cerificada de entrar
	// ak conjunto de acciones a realizar
	// Declaracion de variables
	Definir i Como Entero
	Definir n Como Entero // representa el contador
	// Inicializacion de variables
	i <- 0 // representa el numero de veces a realizar el ciclo
	n <- 5
	// Ejecucion del ciclo y escritura de resultados
	Mientras i<n Hacer
		Escribir i
		i <- i+1 // Acion a realizar
	FinMientras // Incremento de la variable de contador
FinAlgoritmo
